# Disk images are large and, in the case of guest images, must never be
# published (bin/no-apple-bytes.sh refuses them in the tracked tree).
*.qcow2
*.img
*.dmg
*.iso
*.zip

# Python bytecode, left by running a helper script by hand. Never
# something to commit.
__pycache__/
*.pyc

# VERSION is a build product: build/version.sh writes it, the tags
# are the record. A committed copy drifts (family-conventions check 7).
/VERSION

# `bin/dev-install.sh` builds the plugin binary here.
/packer-plugin-macosx

# `goreleaser release`/`goreleaser build`'s own output.
/dist/

# `packer build`/the vagrant post-processor's own output, from
# templates/mavericks/mavericks.pkr.hcl's output_directory and vagrant
# post-processor `output`.
/templates/*/output/
/templates/*/output-*/
*.box
# The manifest post-processor's record of a build.
/templates/*/packer-manifest.json
# The same outputs when packer runs from the repository root
# (`packer build templates/mavericks/`): output_directory, the box and the manifest
# are relative to the working directory, not the template.
/output/
/output-mavericks/
/packer-manifest.json
/.superpowers/
/.idea/

# Superpowers design specs and plans: working documents, not shipped
# (the convention shipyard follows too).
/docs/superpowers/
