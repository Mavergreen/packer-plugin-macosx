# The box's own Vagrantfile. It is packed into the box by
# mavericks.pkr.hcl's post-processor "vagrant" block. `vagrant box add`
# unpacks it beside box.img (v1) or box_0.img (v2), whichever
# vagrant-qemu's box import finds (lib/vagrant-qemu/action/import.rb),
# and beside OVMF_CODE.fd, OVMF_VARS.fd and opencore.img, which
# `include` copied in. It never runs during the Packer build itself.
#
# RENDERED FROM THE BUILD'S OWN SETTINGS. mavericks.pkr.hcl renders this
# file from box.Vagrantfile.pkrtpl, a Packer templatefile(), with the
# build's user, cpu, memory, cpus, nic and accelerator, so the box logs
# in and boots the way its image was built, and with the instruction-set
# levels' cpu lines. A project Vagrantfile can still override any of it.
# The rendering is HCL's: in the template, a dollar sign or a percent
# sign directly before an open brace starts an interpolation or a
# directive.
#
# NOT THE WHOLE VAGRANTFILE. The box's Vagrantfile is the stock vagrant
# post-processor's own libvirt stanza (`config.vm.provider :libvirt`,
# setting libvirt.driver) followed by this file (packer-plugin-vagrant
# v1.1.7's boxVagrantfileContents). Under `vagrant up --provider qemu`
# that libvirt stanza is inert: it configures a provider nobody is using.
# The rendered file also passes through Packer's legacy Go template
# engine twice (the file provisioner that carries it, and the
# post-processor), so it must never contain a double open brace.
#
# THE HOST'S SETTINGS come from its environment, under one prefix every
# Mac OS X box of this project's reads the same way, whatever the
# provider:
#
#   GUEST_MACOSX_GUI           a window: 1, true or yes, in any case, for
#                              one; unset, empty, 0, false or no for none
#   GUEST_MACOSX_QEMU_DISPLAY  qemu only: QEMU's -display, in place of the
#                              host's own window (cocoa on macOS, gtk
#                              elsewhere), such as sdl, or vnc=127.0.0.1:1
#                              for a VNC server on the host's own port
#                              5901; set, it asks for a display,
#                              GUEST_MACOSX_GUI or not, which is how a
#                              headless host shows a guest; none is no
#                              display, the same as unset
#   GUEST_MACOSX_CPU_ISA       qemu only: the guest CPU by the instructions
#                              it has, none, avx or avx2 (below)
#
# A value outside these raises, naming the variable and what it wants,
# before any provider starts a guest set up some way nobody asked for.
# The checks here only record it, in bad, and every provider block raises
# it first: Vagrant rescues an error from a provider block into its own
# "There was an error loading a Vagrantfile" message, while one raised
# outside them, in this block's own body, reaches the user as a Ruby
# backtrace (MEASURED 2026-10-17, Vagrant 2.4.9).
# Vagrant reads this file for every command, so while a bad value stays
# in the environment it stops `vagrant halt` and `vagrant destroy` too;
# the error names the variable to unset, and nothing but that value is
# wrong. A finding about the host, which no value here can fix, warns
# instead and never stops a command (ignore_msrs, below).
#
# THE RELEASE, for a tool that boots this box without Vagrant: the line
# below, a comment Vagrant never reads, names the Mac OS X release the box
# is. bin/gate-vm.sh reads it, and only it, to log in, shut down and size
# the guest as that release needs (docs/decisions/0014, "The boot gate").
# guest-macosx-release: 10.9
Vagrant.configure("2") do |config|
  boxdir = File.expand_path(__dir__)

  bad = nil
  gui_env = ENV["GUEST_MACOSX_GUI"].to_s
  gui = case gui_env.downcase
    when "1", "true", "yes" then true
    when "", "0", "false", "no" then false
    else
      bad = "GUEST_MACOSX_GUI: want 1, true or yes for a window, or 0, false, no or nothing for none (got '#{gui_env}')"
      false
    end
  # It lands in QEMU's arguments, so it is held to what a -display value
  # is made of: a backend, then comma-separated options. That leaves out
  # an IPv6 VNC address and a unix: socket path, on purpose.
  qemu_display = ENV["GUEST_MACOSX_QEMU_DISPLAY"].to_s
  unless qemu_display.match?(/\A([A-Za-z][A-Za-z0-9_.,:=+-]*)?\z/)
    bad ||= "GUEST_MACOSX_QEMU_DISPLAY: want a QEMU -display value, a backend then comma-separated options, such as sdl or vnc=127.0.0.1:1 (got '#{qemu_display}')"
  end
  # none is QEMU's own name for no display: the headless run, daemonized,
  # not a foreground QEMU with nothing to show.
  qemu_display = "" if qemu_display == "none"
  qemu_display = Vagrant::Util::Platform.darwin? ? "cocoa" : "gtk" if gui && qemu_display.empty?

  # :darwin is Vagrant's own guest support for macOS; 10.9 needs no
  # guest additions for it.
  config.vm.guest = :darwin
  config.ssh.username = "${user}"

  config.vm.synced_folder ".", "/vagrant", disabled: true

  # A clean `vagrant halt`. vagrant-qemu's halt presses the ACPI power
  # button, which 10.9 answers with a dialog rather than a shutdown, and
  # after 60s it quits QEMU under the running guest (MEASURED 2026-09-27:
  # no SHUTDOWN_TIME in the guest's system.log). It never asks the guest
  # itself, so this does: passwordless sudo lets the shutdown run, and
  # QEMU exits when the guest powers off. The image's own guest-macosx-shutdown,
  # never a bare `shutdown`, or the guest can wait out a 20 s exit
  # timeout on the way down and keep a .shutdownStall report for it
  # (docs/decisions/0019).
  config.trigger.before :halt do |t|
    t.name = "guest shutdown"
    t.on_error = :continue
    t.run_remote = { inline: "sudo /usr/local/sbin/guest-macosx-shutdown -h" }
  end

  # THE MACHINE'S OWN HOST UUID AND NIC ADDRESS (docs/decisions/0024).
  # Distinct machines have distinct host UUIDs: under QEMU the guest's is
  # QEMU's -uuid, which OpenCore makes its system-id, there before the
  # first daemon asks. Without one the guest derives a UUID from its NIC's
  # MAC, late (10.9 then waits 30 s at every cold boot), and every
  # vagrant-qemu machine has QEMU's one default MAC. So each machine gets
  # a UUID of its own the first time it comes up, kept in its own data
  # dir (.vagrant/machines/<name>/qemu/guest-macosx-host-uuid), the same
  # UUID at every later up, halt and reload, however often Vagrant reads
  # this file; and a NIC address derived from it, locally administered
  # in QEMU's 52:54:00 range, on the first NIC alone (vagrant-qemu puts
  # net_device into that NIC's -device), and never one of QEMU's own
  # defaults (52:54:00:12:34:56 and up), which a second NIC a project adds
  # without an address of its own gets. An address a project gave the NIC,
  # and vagrant-qemu's dual-NIC mode (advanced_network with a private
  # network), which gives each of its NICs one of its own, are left
  # alone. A -uuid already in extra_qemu_args (the project's own) is the
  # machine's: nothing is stored, and the address derives from it. It
  # says which of these it did. Under another provider the provider names
  # its own machine. Vagrant itself empties the data dir on a destroy that
  # happens, so the next machine of that name is new; no trigger here
  # deletes the UUID (an after-destroy trigger runs on a declined destroy
  # too, and would make a live machine a new host).
  config.trigger.before :up, :reload do |t|
    t.name = "guest-macosx host UUID"
    t.ruby do |_env, machine|
      next unless machine.provider_name.to_s == "qemu"
      qc = machine.provider_config
      args = qc.extra_qemu_args
      if (own = args.index("-uuid"))
        uuid = args[own + 1].to_s
        said = "the project's own -uuid"
      else
        store = machine.data_dir.join("guest-macosx-host-uuid")
        uuid = File.exist?(store) ? File.read(store).strip : ""
        if uuid.match?(/\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/)
          said = "kept in #{store}"
        else
          said = uuid.empty? ? "new" : "new (the stored value was not a UUID)"
          require "securerandom"
          uuid = SecureRandom.uuid
          File.write(store, uuid + "\n")
          said += ", kept in #{store}"
        end
        args.push("-uuid", uuid)
      end
      if qc.advanced_network && machine.config.vm.networks.any? { |type, _| type == :private_network }
        nic = "vagrant-qemu's own dual-NIC addresses"
      elsif qc.net_device.to_s.include?("mac=")
        nic = "the project's own address"
      else
        require "digest"
        h = Digest::SHA256.hexdigest(uuid)
        i = 0
        i += 6 while h[i, 4] == "1234"
        mac = "52:54:00:#{h[i, 2]}:#{h[i + 2, 2]}:#{h[i + 4, 2]}"
        qc.net_device = "#{qc.net_device},mac=#{mac}"
        nic = "#{mac}, derived from the UUID"
      end
      machine.ui.detail("host UUID #{uuid} (#{said}); first NIC: #{nic}")
    end
  end

  config.vm.provider "qemu" do |qe|
    raise bad if bad
    qe.arch = "x86_64"
    qe.machine = "q35,vmport=off%{ if accelerator != "none" },accel=${accelerator}%{ endif }"
    # The CPU. Unset, GUEST_MACOSX_CPU_ISA keeps the build's own cpu line.
    # Set, it asks for a guest by what it can run: none (no AVX), avx
    # (Sandy Bridge: AVX, not AVX2, FMA or BMI) or avx2 (Ivy Bridge with
    # Haswell's AVX2, FMA, BMI1, BMI2, MOVBE and LZCNT), each a line
    # measured on this image (docs/decisions/0009, "The instruction-set
    # levels"). Under KVM a level is what the guest is told: none makes
    # the AVX family fault, but on an AVX2 host every other instruction
    # above a level still runs; only TCG makes them all fault. enforce
    # makes QEMU refuse, naming the feature, a host that lacks one.
    isa = ENV["GUEST_MACOSX_CPU_ISA"].to_s
    qe.cpu = case isa
      when "" then "${cpu}"
      when "none" then "${cpu_none}"
      when "avx" then "${cpu_avx}"
      when "avx2" then "${cpu_avx2}"
      else raise "GUEST_MACOSX_CPU_ISA: want none, avx or avx2 (got '#{isa}')"
      end
    # avx and avx2 are Nehalem or later, whose MSR reads KVM faults unless
    # ignore_msrs is on, and 10.9 then resets in a loop with nothing on
    # the screen (docs/decisions/0009). A warning, not an error: it must
    # not stop a halt or a destroy.
    msrs = "/sys/module/kvm/parameters/ignore_msrs"
    if "${accelerator}" == "kvm" && %w(avx avx2).include?(isa) && File.readable?(msrs) && File.read(msrs).strip != "Y"
      $stderr.puts "GUEST_MACOSX_CPU_ISA=#{isa} needs kvm.ignore_msrs=Y on this host, or 10.9 resets in a loop: echo Y | sudo tee #{msrs}"
    end
    qe.smp = "${cpus}"
    qe.memory = "%{ if memory % 1024 == 0 }${memory / 1024}G%{ else }${memory}M%{ endif }"
    qe.net_device = "${nic}"
    qe.drive_interface = "ide"

    # A headless run (the default) daemonizes QEMU and drops the
    # display entirely; a display (GUEST_MACOSX_GUI, or
    # GUEST_MACOSX_QEMU_DISPLAY) needs QEMU to stay in the foreground
    # (no_daemonize, which vagrant-qemu still detaches from the command)
    # with a real -display in place of "none".
    qe.no_daemonize = true unless qemu_display.empty?
    qe.other_default = %W(-parallel none)

    # OpenCore's disk is a virtio-blk disk, which OVMF boots first
    # (bootindex) and neither 10.6 nor 10.9 has a driver for, so the guest
    # never sees it (on AHCI, 10.6's DiskArbitration called it unreadable
    # at every desktop login). USB carries the
    # keyboard and pointer alone: an EHCI controller of its own, no UHCI
    # companions and no XHCI, the same on both releases. QEMU's usb-kbd and
    # usb-tablet are high-speed devices, so they need no companion; 10.9's
    # and 10.6's AppleUSBEHCI drive them, and neither release loads
    # AppleUSBUHCI, the driver that wedged 10.6.0's installs
    # (docs/decisions/0014). EHCI sits at the ICH9's own USB slot, 0x1d.0,
    # which avoids the stall measured with it in the first free slot, on the
    # NIC's line (vagrant-qemu puts the NIC first); why 10.6.0's EHCI never
    # serviced its interrupt there is not established, and that no other
    # device shares 0x1d's line is REASONED from q35's routing. A tablet, not
    # a mouse: it points without a grab (docs/decisions/0035).
    qe.extra_qemu_args = %W(
      -drive if=pflash,format=raw,unit=0,readonly=on,file=#{boxdir}/OVMF_CODE.fd
      -drive if=pflash,format=raw,unit=1,snapshot=on,file=#{boxdir}/OVMF_VARS.fd
      -drive id=opencore,if=none,format=raw,snapshot=on,file=#{boxdir}/opencore.img
      -device virtio-blk-pci,drive=opencore,bootindex=0,bus=pcie.0,addr=0x10
      -device ich9-usb-ehci1,id=ehci,bus=pcie.0,addr=0x1d.0
      -device usb-kbd,bus=ehci.0
      -device usb-tablet,bus=ehci.0
      -device VGA,vgamem_mb=64
    ) + %W(-display #{qemu_display.empty? ? "none" : qemu_display})
  end

  # VirtualBox and VMware: the convention, for the day a box of this
  # project's runs on either. Today's boxes are qemu's alone, so neither
  # block has been measured, and each sets only its provider's own
  # window switch. Neither can warn that it ignores the qemu-only
  # GUEST_MACOSX_QEMU_DISPLAY and GUEST_MACOSX_CPU_ISA: Vagrant runs every
  # provider's block on every command, so the warning would print under
  # qemu too. A box for either provider must find a way to say so, as the
  # Snow Leopard box does for its ignored CPU_ISA, never ignore them in
  # silence.
  config.vm.provider "virtualbox" do |vb|
    raise bad if bad
    vb.gui = true if gui
  end
  config.vm.provider "vmware_desktop" do |v|
    raise bad if bad
    v.gui = true if gui
  end
end
