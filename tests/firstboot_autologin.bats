#!/usr/bin/env bats
# platform: host-agnostic
#
# firstboot.sh's account secret and auto-login. loginwindow logs in by
# itself only with the account's password, which it reads from
# /etc/kcpassword. 10.9's `dscl . -create` gives a new account a random
# password of its own (MEASURED 2026-10-15), so with no password the build
# set, auto-login can only fail: "authorizationhost: Failed to authenticate
# user <vagrant> (error: 9)" at every boot, and the login window stays (6 of
# 6 boots). An empty password does not help: with no kcpassword, or an empty
# one, it fails the same way (10 of 10). With the password set, checked, and
# in kcpassword, the account logged in on 5 of 5 warm boots. 10.6's account
# has no password at all, and its login window stays too.
#
# So firstboot turns auto-login on only when the password is one it set and
# `dscl . -authonly` accepted, and otherwise leaves neither autoLoginUser nor
# kcpassword behind and logs why. The default build sets no password (the
# owner's decision, 2026-10-15), so it boots to the login window.
#
# A configured password is a secret: it must reach no log, no console and no
# file but kcpassword. The behaviour tests below run firstboot's own
# functions under this host's /bin/sh, with stub `dscl` and `defaults` that
# record their arguments, a `dscl` that echoes its arguments back (the worst
# case for a log), and every path pointed into the test's own directory.
#
# SAFETY: the guest runs on this machine, so it gets PATH=stubs:/usr/bin:/bin
# (no sbin), and every name that could touch the host (shutdown, reboot,
# halt, killall, sudo, date) is a stub that refuses. dscl and defaults are
# stubs. Only perl (kcpassword_encode), sh, sed, mv, rm and sleep are real.

setup() {
    REPO="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
    FB="$REPO/assets/guest/firstboot.sh"
    FNS="$BATS_TEST_TMPDIR/fns.sh"
    : > "$FNS"
    for f in say redact run_secret_with_timeout set_account_secret \
        autologin_plan kcpassword_encode configure_autologin forget_account_secret; do
        fn=$(awk "/^$f\\(\\) \\{/,/^\\}/" "$FB")
        [ -n "$fn" ] || { echo "firstboot.sh has no function $f" >&2; return 1; }
        printf '%s\n' "$fn" >> "$FNS"
    done

    STUB="$BATS_TEST_TMPDIR/stub"
    mkdir -p "$STUB"
    G="$BATS_TEST_TMPDIR/guest"
    mkdir -p "$G/conf"
    # dscl: records its arguments, says them on stdout and stderr (so a log
    # that keeps its output would show the secret), and answers -authonly
    # with $STUB_AUTHONLY_RC after $STUB_AUTHONLY_SLEEP seconds.
    cat > "$STUB/dscl" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$STUB_DSCL_CALLS"
# The mode of the file the secret runner gives it for its output: exactly
# 0600 or not (find's -perm with no prefix is an exact match, in GNU and BSD
# find alike).
if [ -n "$(find "$STUB_OUT_FILE" -prune -type f -perm 600 2>/dev/null)" ]; then
    echo -rw------- >> "$STUB_DSCL_CALLS.modes"
else
    echo "not a mode-0600 file" >> "$STUB_DSCL_CALLS.modes"
fi
echo "dscl (stub) was given: $*"
echo "dscl (stub) complains about: $*" >&2
if [ "${2:-}" = -authonly ]; then
    [ -z "${STUB_AUTHONLY_SLEEP:-}" ] || sleep "$STUB_AUTHONLY_SLEEP"
    exit "${STUB_AUTHONLY_RC:-0}"
fi
exit 0
EOF
    # defaults: records its arguments, and does nothing else.
    cat > "$STUB/defaults" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$STUB_DEFAULTS_CALLS"
exit 0
EOF
    # date: say's timestamp, fixed.
    cat > "$STUB/date" <<'STUB'
#!/bin/sh
echo 2026-10-15T00:00:00Z
STUB
    for name in shutdown reboot halt killall sudo; do
        cat > "$STUB/$name" <<'STUB'
#!/bin/sh
echo "stub ${0##*/} refused: $*" >&2
exit 99
STUB
    done
    chmod +x "$STUB"/*

    PW=f13-test-pw
    export STUB_DSCL_CALLS="$G/dscl.calls" STUB_DEFAULTS_CALLS="$G/defaults.calls"
    : > "$STUB_DSCL_CALLS"
    : > "$STUB_DEFAULTS_CALLS"
    printf '# Generated by packer-plugin-macosx. Do not edit.\nGUEST_MACOSX_FB_USER=vagrant\nGUEST_MACOSX_FB_PASSWORD=%s\n' "$PW" > "$G/conf/firstboot.conf"
    chmod 600 "$G/conf/firstboot.conf"
}

# firstboot <asked> <password>: firstboot's account-secret and auto-login
# steps, as its main line runs them, for GUEST_MACOSX_FB_AUTOLOGIN=<asked> and
# GUEST_MACOSX_FB_PASSWORD=<password> ("" for none), or, for <password> "from-conf",
# whatever $G/conf/firstboot.conf says, as the main line sources it. The user
# is $FB_USER (vagrant). Its stdout and stderr (the LaunchDaemon's .out and
# .err) are $output; its log is $G/guest-macosx-firstboot.log.
firstboot() {
    run env -i PATH="$STUB:/usr/bin:/bin" \
        STUB_DSCL_CALLS="$STUB_DSCL_CALLS" STUB_DEFAULTS_CALLS="$STUB_DEFAULTS_CALLS" \
        STUB_AUTHONLY_RC="${STUB_AUTHONLY_RC:-0}" STUB_AUTHONLY_SLEEP="${STUB_AUTHONLY_SLEEP:-}" \
        STUB_OUT_FILE="$G/conf/.secret-run.out" FB_USER="${FB_USER:-vagrant}" \
        G="$G" FNS="$FNS" ASKED="$1" PASSWORD="$2" SECRET_LIMIT="${SECRET_LIMIT:-60}" \
        /bin/sh -c '
            . "$FNS"
            LOG=$G/guest-macosx-firstboot.log
            CONF_DIR=$G/conf
            KC_FILE=$G/kcpassword
            LOGINWINDOW_PREFS=$G/com.apple.loginwindow
            GUEST_MACOSX_FB_USER=$FB_USER
            GUEST_MACOSX_FB_AUTOLOGIN=$ASKED
            if [ "$PASSWORD" = from-conf ]; then
                . "$CONF_DIR/firstboot.conf"
            else
                GUEST_MACOSX_FB_PASSWORD=$PASSWORD
            fi
            set_account_secret
            configure_autologin
            echo "AUTOLOGIN=$AUTOLOGIN"
        '
}

# mode <file>: its permissions, as ls shows them.
mode() {
    ls -l "$1" | cut -c1-10
}

# within <seconds> <command...>: the command, failed with status 124 if it is
# still running after <seconds>, so a hang fails a test instead of stopping
# the suite. It kills only the command's own process: give it no pipeline.
within() {
    secs=$1
    shift
    "$@" &
    pid=$!
    n=0
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$n" -ge $((secs * 10)) ]; then
            kill -9 "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            echo "still running after ${secs}s: $*" >&2
            return 124
        fi
        sleep 0.1
        n=$((n + 1))
    done
    wait "$pid"
}

# hex <file>: its bytes, as hex.
hex() {
    od -An -tx1 "$1" | tr -d ' \n'
}

# encode <password>: kcpassword_encode's bytes, as hex, under this host's /bin/sh
encode() {
    sh -c '. "$1"; printf %s "$2" | kcpassword_encode | od -An -tx1 | tr -d " \n"' _ "$FNS" "$1"
}

# no_secret_anywhere: the password is in neither the log nor the output.
no_secret_anywhere() {
    ! grep -qF "$PW" "$G/guest-macosx-firstboot.log" || { echo "the password is in the log" >&2; return 1; }
    [[ "$output" != *"$PW"* ]] || { echo "the password is on stdout or stderr" >&2; return 1; }
}

# --- the plan ---------------------------------------------------------------

@test "auto-login asked for, with a password set and accepted: on" {
    . "$FNS"
    run autologin_plan 1 verified
    [ "$status" -eq 0 ]
    [ "$output" = on ]
}

@test "auto-login asked for, with no password: off, saying why" {
    . "$FNS"
    run autologin_plan 1 none
    [ "$output" = off-no-password ]
}

@test "auto-login asked for, with a password dscl refused: off, saying why" {
    . "$FNS"
    run autologin_plan 1 rejected
    [ "$output" = off-password-rejected ]
}

@test "auto-login not asked for: off, whatever the password" {
    . "$FNS"
    for p in verified none rejected; do
        run autologin_plan 0 "$p"
        [ "$output" = off-not-asked ]
    done
}

# --- the encoder ------------------------------------------------------------

@test "kcpassword_encode writes what a 10.9 guest auto-logged-in with" {
    # MEASURED: /etc/kcpassword of the probe guest that reached the desktop
    # on 5 of 5 warm boots (2026-10-15), for the throwaway password
    # f13-test-pw (11 characters): the password, then a NUL, each byte
    # XORed with the key.
    run encode f13-test-pw
    [ "$output" = 1bb8610ea6d9ae9e8ec9687d ]
}

@test "kcpassword_encode ends every password with a NUL, then pads to 12 bytes" {
    # REASONED, not measured: only the 11-character case above was tried in
    # a guest. Every length is given that case's shape -- the password, a
    # NUL, and NULs to the next multiple of 12 -- so a password whose
    # length is a multiple of 12 still ends in a NUL, which the published
    # format calls for. The key is 7d 89 52 23 d2 bc dd ea a3 b9 1f.
    run encode 123456789012
    [ "${#output}" -eq 48 ]
    [ "${output:24:2}" = 89 ]   # byte 12, NUL ^ key[12 % 11]
    run encode 12345
    [ "${#output}" -eq 24 ]
    [ "${output:10:14}" = bcddeaa3b91f7d ]   # bytes 5-11, NULs ^ key
}

@test "kcpassword_encode writes nothing for no password" {
    run encode ""
    [ -z "$output" ]
}

# --- the secret and auto-login, run ------------------------------------------

@test "no password: dscl is never asked, auto-login is off and nothing is left behind" {
    printf 'stale' > "$G/kcpassword"   # an older image's
    firstboot 1 ""
    [ "$status" -eq 0 ]
    [[ "$output" == *"AUTOLOGIN=off-no-password"* ]] || false
    [ ! -s "$STUB_DSCL_CALLS" ]
    grep -qxF "delete $G/com.apple.loginwindow autoLoginUser" "$STUB_DEFAULTS_CALLS"
    ! grep -q '^write' "$STUB_DEFAULTS_CALLS" || false
    [ ! -e "$G/kcpassword" ]
    grep -qF "no account secret configured" "$G/guest-macosx-firstboot.log"
    grep -qF "auto-login: off (off-no-password): loginwindow needs vagrant's password" "$G/guest-macosx-firstboot.log"
}

@test "a password dscl -authonly refuses: auto-login is off, saying so, and nothing is left behind" {
    printf 'stale' > "$G/kcpassword"
    export STUB_AUTHONLY_RC=1
    firstboot 1 "$PW"
    [ "$status" -eq 0 ]
    [[ "$output" == *"AUTOLOGIN=off-password-rejected"* ]] || false
    grep -qxF ". -passwd /Users/vagrant $PW" "$STUB_DSCL_CALLS"
    grep -qxF ". -authonly vagrant $PW" "$STUB_DSCL_CALLS"
    grep -qxF "delete $G/com.apple.loginwindow autoLoginUser" "$STUB_DEFAULTS_CALLS"
    ! grep -q '^write' "$STUB_DEFAULTS_CALLS" || false
    [ ! -e "$G/kcpassword" ]
    grep -qF "dscl . -authonly: rejected" "$G/guest-macosx-firstboot.log"
    grep -qF "auto-login: off (off-password-rejected)" "$G/guest-macosx-firstboot.log"
    no_secret_anywhere
}

@test "a password dscl -authonly accepts: autoLoginUser, and kcpassword as the guest logged in with, root's only" {
    printf 'stale, and readable' > "$G/kcpassword"
    chmod 644 "$G/kcpassword"
    firstboot 1 "$PW"
    [ "$status" -eq 0 ]
    [[ "$output" == *"AUTOLOGIN=on"* ]] || false
    grep -qxF "write $G/com.apple.loginwindow autoLoginUser vagrant" "$STUB_DEFAULTS_CALLS"
    [ "$(hex "$G/kcpassword")" = 1bb8610ea6d9ae9e8ec9687d ]
    [ "$(mode "$G/kcpassword")" = -rw------- ]
    grep -qF "dscl . -authonly: verified" "$G/guest-macosx-firstboot.log"
    grep -qF "auto-login: on: vagrant's password, which dscl . -authonly verified, is in $G/kcpassword" "$G/guest-macosx-firstboot.log"
    no_secret_anywhere
}

@test "a new kcpassword is root's only from the moment it exists" {
    umask 022
    firstboot 1 "$PW"
    [[ "$output" == *"AUTOLOGIN=on"* ]] || false
    [ "$(mode "$G/kcpassword")" = -rw------- ]
}

@test "a kcpassword that cannot be written leaves auto-login off, not half on" {
    # the encoder fails
    cat > "$STUB/perl" <<'STUB'
#!/bin/sh
exit 1
STUB
    chmod +x "$STUB/perl"
    firstboot 1 "$PW"
    [ "$status" -eq 0 ]
    [[ "$output" == *"AUTOLOGIN=off-kcpassword-failed"* ]] || false
    ! grep -q '^write' "$STUB_DEFAULTS_CALLS" || false
    grep -qxF "delete $G/com.apple.loginwindow autoLoginUser" "$STUB_DEFAULTS_CALLS"
    [ ! -e "$G/kcpassword" ]
    grep -qF "auto-login: off (off-kcpassword-failed)" "$G/guest-macosx-firstboot.log"
}

@test "auto-login not asked for: off, saying so, and nothing is left behind" {
    printf 'stale' > "$G/kcpassword"
    firstboot 0 "$PW"
    [ "$status" -eq 0 ]
    [[ "$output" == *"AUTOLOGIN=off-not-asked"* ]] || false
    grep -qxF "delete $G/com.apple.loginwindow autoLoginUser" "$STUB_DEFAULTS_CALLS"
    ! grep -q '^write' "$STUB_DEFAULTS_CALLS" || false
    [ ! -e "$G/kcpassword" ]
    grep -qF "auto-login: off (off-not-asked)" "$G/guest-macosx-firstboot.log"
}

@test "a dscl -authonly that hangs is cut off, and counts as a refusal" {
    export SECRET_LIMIT=1 STUB_AUTHONLY_SLEEP=5 STUB_AUTHONLY_RC=0
    start=$(date +%s)
    firstboot 1 "$PW"
    [ $(( $(date +%s) - start )) -lt 4 ]
    [[ "$output" == *"AUTOLOGIN=off-password-rejected"* ]] || false
    grep -qF "TIMED OUT after 1s: dscl . -authonly vagrant <redacted>" "$G/guest-macosx-firstboot.log"
    no_secret_anywhere
}

@test "the log shows each dscl call with the password redacted, and its output too" {
    firstboot 1 "$PW"
    grep -qF "run (60s limit): dscl . -passwd /Users/vagrant <redacted>" "$G/guest-macosx-firstboot.log"
    grep -qF "run (60s limit): dscl . -authonly vagrant <redacted>" "$G/guest-macosx-firstboot.log"
    grep -qF "dscl (stub) was given: . -authonly vagrant <redacted>" "$G/guest-macosx-firstboot.log"
    grep -qF "dscl (stub) complains about: . -passwd /Users/vagrant <redacted>" "$G/guest-macosx-firstboot.log"
    no_secret_anywhere
}

@test "redact replaces every occurrence, takes the secret literally, and keeps the rest" {
    printf '%s\n' "a.*b x a.*b" "none here" "a.*ba.*b" "a.Xb" > "$BATS_TEST_TMPDIR/in"
    run within 10 sh -c '. "$1"; redact "a.*b" < "$2"' _ "$FNS" "$BATS_TEST_TMPDIR/in"
    [ "$status" -eq 0 ]
    [ "${lines[0]}" = "<redacted> x <redacted>" ]
    [ "${lines[1]}" = "none here" ]
    [ "${lines[2]}" = "<redacted><redacted>" ]
    [ "${lines[3]}" = "a.Xb" ]
}

@test "redact matches a secret full of pattern characters only as itself" {
    # As a pattern, [ab]x would match the "ax" first and leave the real
    # occurrence; *?x and \[ would match far more than themselves.
    printf '%s\n' "ax[ab]x" "bx" > "$BATS_TEST_TMPDIR/in1"
    printf '%s\n' 'aa*?x\[b q' > "$BATS_TEST_TMPDIR/in2"
    run within 10 sh -c '. "$1"; redact "[ab]x" < "$2"; redact "*?x\[" < "$3"' \
        _ "$FNS" "$BATS_TEST_TMPDIR/in1" "$BATS_TEST_TMPDIR/in2"
    [ "$status" -eq 0 ]
    [ "${lines[0]}" = "ax<redacted>" ]
    [ "${lines[1]}" = "bx" ]
    [ "${lines[2]}" = "aa<redacted>b q" ]
}

@test "redact with no secret passes its input through, and returns" {
    printf 'a\nb\n' > "$BATS_TEST_TMPDIR/in"
    run within 10 sh -c '. "$1"; redact "" < "$2"' _ "$FNS" "$BATS_TEST_TMPDIR/in"
    [ "$status" -eq 0 ]
    [ "$output" = "$(printf 'a\nb')" ]
}

@test "the secret runner's file for dscl's output is root's only, and gone afterwards" {
    umask 022
    firstboot 1 "$PW"
    [ "$(wc -l < "$STUB_DSCL_CALLS.modes")" -eq 2 ]
    [ "$(sort -u "$STUB_DSCL_CALLS.modes")" = -rw------- ]
    [ ! -e "$G/conf/.secret-run.out" ]
}

@test "the logged command line redacts the password argument, not the user name it overlaps" {
    # A password that begins where the user name ends: redacting the line
    # as one string would match across the two arguments and leave part of
    # the password showing.
    export FB_USER=bob
    PW="b b"
    printf 'GUEST_MACOSX_FB_USER=bob\nGUEST_MACOSX_FB_PASSWORD=b\\ b\n' > "$G/conf/firstboot.conf"
    firstboot 1 "$PW"
    grep -qF "run (60s limit): dscl . -authonly bob <redacted>" "$G/guest-macosx-firstboot.log"
    grep -qF "run (60s limit): dscl . -passwd /Users/bob <redacted>" "$G/guest-macosx-firstboot.log"
}

@test "a first boot run again after the password left the conf says so, and leaves auto-login off" {
    firstboot 1 from-conf
    [[ "$output" == *"AUTOLOGIN=on"* ]] || false
    firstboot 1 from-conf
    [[ "$output" == *"AUTOLOGIN=off-no-password"* ]] || false
    grep -qF "no account secret: an earlier run used the configured one and removed it from $G/conf/firstboot.conf" "$G/guest-macosx-firstboot.log"
    [ "$(grep -c "no account secret configured" "$G/guest-macosx-firstboot.log")" -eq 0 ]
    [ ! -e "$G/kcpassword" ]
    no_secret_anywhere
}

@test "the password leaves firstboot.conf once it is used, and the rest stays" {
    firstboot 1 "$PW"
    ! grep -qF "$PW" "$G/conf/firstboot.conf" || false
    ! grep -q '^GUEST_MACOSX_FB_PASSWORD=' "$G/conf/firstboot.conf" || false
    grep -qxF "GUEST_MACOSX_FB_USER=vagrant" "$G/conf/firstboot.conf"
    [ "$(mode "$G/conf/firstboot.conf")" = -rw------- ]
    grep -qF "account secret removed from $G/conf/firstboot.conf" "$G/guest-macosx-firstboot.log"
}

@test "a conf with no password is left alone" {
    printf '# Generated by packer-plugin-macosx. Do not edit.\nGUEST_MACOSX_FB_USER=vagrant\n' > "$G/conf/firstboot.conf"
    cp "$G/conf/firstboot.conf" "$G/before"
    firstboot 1 ""
    cmp "$G/before" "$G/conf/firstboot.conf"
    ! grep -qF "account secret removed" "$G/guest-macosx-firstboot.log"
}

# --- where the password may appear in firstboot.sh ---------------------------

@test "firstboot.sh hands the password only to dscl, through the redacting runner, and to the encoder" {
    # Every line of code that names it, and nothing else. A new one --
    # a say, an echo, a run_with_timeout -- fails here until it is shown
    # not to reach a log, the console or a process list.
    got=$(grep -v '^[[:space:]]*#' "$FB" | grep 'GUEST_MACOSX_FB_PASSWORD' | sed -e 's/^[[:space:]]*//')
    want=$(cat <<'EOF'
if [ -z "${GUEST_MACOSX_FB_PASSWORD:-}" ]; then
run_secret_with_timeout "$SECRET_LIMIT" "$GUEST_MACOSX_FB_PASSWORD" \
dscl . -passwd "/Users/$GUEST_MACOSX_FB_USER" "$GUEST_MACOSX_FB_PASSWORD"
if run_secret_with_timeout "$SECRET_LIMIT" "$GUEST_MACOSX_FB_PASSWORD" \
dscl . -authonly "$GUEST_MACOSX_FB_USER" "$GUEST_MACOSX_FB_PASSWORD"; then
printf '%s' "$GUEST_MACOSX_FB_PASSWORD" | kcpassword_encode > "$KC_FILE"
_key=GUEST_MACOSX_FB_PASSWORD
EOF
)
    [ "$got" = "$want" ] || { diff <(echo "$want") <(echo "$got") >&2; false; }
}

@test "loginwindow is restarted for auto-login only when it is on" {
    run grep -n 'killall -HUP loginwindow' "$FB"
    [ "${#lines[@]}" -eq 1 ]
    n=${lines[0]%%:*}
    guard=$(sed -n "$((n - 3)),$((n - 1))p" "$FB")
    [[ "$guard" == *'[ "$AUTOLOGIN" = on ]'* ]] || false
}

@test "the main line runs the secret, then auto-login, each once" {
    [ "$(grep -c '^set_account_secret$' "$FB")" -eq 1 ]
    [ "$(grep -c '^configure_autologin$' "$FB")" -eq 1 ]
    s=$(grep -n '^set_account_secret$' "$FB" | cut -d: -f1)
    a=$(grep -n '^configure_autologin$' "$FB" | cut -d: -f1)
    h=$(grep -n 'killall -HUP loginwindow' "$FB" | cut -d: -f1)
    [ "$s" -lt "$a" ] && [ "$a" -lt "$h" ]
}

@test "the lines verify.sh looks for in the first boot's log are the lines it writes" {
    firstboot 1 "$PW"
    [[ "$output" == *"AUTOLOGIN=on"* ]] || false
    for v in mavericks snowleopard; do
        wants=$(sed -n -e 's/.*has "\([^"]*\)" "\$FBLOG".*/\1/p' "$REPO/templates/$v/verify.sh")
        [ "$(printf '%s\n' "$wants" | wc -l)" -eq 2 ]
        while IFS= read -r want; do
            want=${want//\$autologin/vagrant}
            grep -qF -- "$want" "$G/guest-macosx-firstboot.log" ||
                { echo "templates/$v/verify.sh wants '$want'; the first boot never says it" >&2; false; }
        done <<< "$wants"
    done
}
